# Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Application ────────────────────────────────────────────
APP_NAME=maze-runner
APP_ENV=development
APP_VERSION=1.0.0

# ─── Backend ────────────────────────────────────────────────
BACKEND_PORT=8080
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maze_runner
POSTGRES_USER=maze_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ─── Email (SMTP) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=noreply@maze-runner.app

# ─── Adminer (DB GUI - dev only) ─────────────────────────────
ADMINER_PORT=8090

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
